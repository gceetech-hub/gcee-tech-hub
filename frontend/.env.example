# Frontend API base URL.
#
# Leave EMPTY (or omit the file) for the default relative `/api` path:
#   - local dev: Vite proxies `/api` -> http://localhost:5000 (see vite.config.ts)
#   - production: Vercel rewrites `/api/*` -> the serverless API function
#
# Only set this when the backend is deployed on a SEPARATE origin, e.g.:
# VITE_API_URL=https://your-backend.example.com/api
VITE_API_URL=
