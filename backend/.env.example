# --- MongoDB (REQUIRED) ---
# Paste your real MongoDB Atlas connection string here. Do NOT commit this file.
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gcee-tech-hub?retryWrites=true&w=majority
# If your network blocks SRV DNS lookups, set FORCE_DNS=8.8.8.8,1.1.1.1
MONGODB_URI=

# Set FORCE_DNS when the local network DNS refuses SRV lookups (Mongo "querySrv ECONNREFUSED").
# FORCE_DNS=8.8.8.8,1.1.1.1

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=30d
COOKIE_SECURE=false

# --- App ---
PORT=5000
NODE_ENV=development

# --- Initial admin (used by seedAdmin on startup and by the seed script) ---
ADMIN_NAME=GCEE Tech Hub Admin
ADMIN_EMAIL=admin@gceetechhub.in
ADMIN_PASSWORD=Admin@123

# --- Email (REQUIRED for signup OTP / notifications) ---
# The app sends via Resend when RESEND_API_KEY is set, otherwise via Gmail SMTP.
# Configure at least ONE provider, or signup/OTP emails will fail.
SITE_EMAIL=gceetech@gmail.com
# Gmail SMTP path:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Set GMAIL_USER to that account and GMAIL_APP_PASSWORD to the 16-char password.
GMAIL_USER=gceetech@gmail.com
GMAIL_APP_PASSWORD=
# Resend path (optional; falls back to Gmail SMTP automatically):
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=GCEE Tech Hub
CONTACT_RECIPIENT_EMAIL=gceetech@gmail.com
# Optional: force a provider ("auto" | "gmail" | "resend"). Default: auto.
# EMAIL_PROVIDER=auto
# Optional: point the SMTP transporter at a non-Gmail server (default smtp.gmail.com:465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
